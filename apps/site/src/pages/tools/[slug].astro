---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConfigTabs from '../../components/ConfigTabs.astro';
import DictionaryCard from '../../components/DictionaryCard.astro';
import { formatStars } from '../../lib/entries';

export async function getStaticPaths() {
  const toolEntries = await getCollection('tools');
  const byCategory = new Map<string, typeof toolEntries>();

  for (const entry of toolEntries) {
    for (const cat of entry.data.categories) {
      let list = byCategory.get(cat);
      if (!list) {
        list = [];
        byCategory.set(cat, list);
      }
      list.push(entry);
    }
  }
  for (const list of byCategory.values()) {
    list.sort((a, b) => (b.data.signals?.stars || 0) - (a.data.signals?.stars || 0));
  }

  return toolEntries.map((entry) => {
    const primaryCategory = entry.data.categories[0] || 'other';
    const relatedTools = (byCategory.get(primaryCategory) || [])
      .filter((e) => e.data.slug !== entry.data.slug)
      .slice(0, 4);
    return {
      params: { slug: entry.data.slug },
      props: { entry, relatedTools },
    };
  });
}

const { entry, relatedTools = [] } = Astro.props;
const data = entry.data;
const { Content, headings } = await render(entry);

// Headings for table of contents
const tocHeadings = headings ? headings.filter((h) => h.depth >= 2 && h.depth <= 3) : [];
const primaryCategory = data.categories[0] || 'other';

// Format why listed
function getWhyListedText(reason: string, percentile: number): string {
  if (reason === 'official_vendor') {
    return 'Official vendor repository verified from primary provider';
  }
  if (reason === 'pinned') {
    return 'Curator highlighted entry';
  }
  const topPct = Math.max(1, 100 - (percentile || 0));
  return `Ranked in the top ${topPct}% by community adoption, code health, and recent maintenance`;
}

const subcategoryLabels: Record<string, string> = {
  coding_agent: 'Coding Agent',
  agent_framework: 'Agent Framework',
  browser_agent: 'Browser Agent',
  memory_rag: 'Memory & RAG',
  eval_observability: 'Eval & Observability',
  sdk_harness: 'SDK & Harness',
  desktop_ui: 'Desktop UI',
  other: 'Agent Tool',
};

const subcategoryLabel = subcategoryLabels[data.tool.subcategory] || 'Agent Tool';
const quickstartCmd = data.tool.install_command || `git clone https://github.com/${data.source.repo}.git`;
---

<BaseLayout
  title={`${data.name} — AI Agent Tool & Repository`}
  description={data.summary || data.tagline || `Installation and overview for ${data.name}.`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6">
      <a href="/" class="hover:text-slate-900">Home</a>
      <span>/</span>
      <a href="/tools" class="hover:text-slate-900">Agent Tools</a>
      <span>/</span>
      <span class="text-slate-800 font-medium">{data.name}</span>
    </nav>

    <!-- Unified Dictionary Entry Header -->
    <div class="mb-10">
      <DictionaryCard entry={entry} />
    </div>

    <!-- Language Note -->
    {data.language && data.language !== 'en' && (
      <div class="mb-8 p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-xs flex items-center gap-3">
        <svg class="w-5 h-5 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
        </svg>
        <p>
          <strong>Notice:</strong> This repository's primary documentation is written in {data.language === 'zh' ? 'Chinese' : data.language}.
        </p>
      </div>
    )}

    <!-- Main Content Area: README + Sidebar -->
    <div class="flex flex-col lg:flex-row gap-10">
      <!-- Left / Main Reading Column -->
      <div class="min-w-0 flex-1 max-w-4xl">
        <!-- Quickstart Install Box -->
        <section id="install" class="mb-10 p-6 rounded-2xl bg-slate-900 text-white shadow-lg">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-sm font-semibold tracking-wide uppercase text-slate-300">
              ⚡ Quickstart Installation
            </h2>
            <span class="text-[11px] font-mono text-slate-400 uppercase">{data.tool.runtime}</span>
          </div>
          <div class="relative bg-slate-950 rounded-xl p-4 border border-slate-800 font-mono text-sm flex items-center justify-between gap-4">
            <code class="text-emerald-400 truncate select-all">{quickstartCmd}</code>
            <button
              type="button"
              class="copy-quickstart-btn shrink-0 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs text-slate-200 font-medium transition-colors cursor-pointer"
              data-cmd={quickstartCmd}
            >
              Copy
            </button>
          </div>
        </section>

        <!-- MCP Integration Config (if hybrid tool) -->
        {data.tool.has_mcp_support && data.tool.mcp_launch && (
          <section id="mcp-config" class="mb-10 p-6 rounded-2xl bg-white border border-slate-200 shadow-xs">
            <h2 class="text-lg font-bold text-slate-900 mb-2">🔌 MCP Server Integration</h2>
            <p class="text-xs text-slate-600 mb-4">
              This tool provides an MCP server interface for Claude Code, Codex, and Antigravity.
            </p>
            <ConfigTabs
              type="mcp_server"
              name={data.name}
              launchSpec={data.tool.mcp_launch}
              repo={data.source.repo}
            />
          </section>
        )}

        <!-- About (README) -->
        <section id="about" class="mb-12">
          <div class="flex items-center justify-between pb-3 mb-6 border-b border-slate-200">
            <h2 class="text-xl font-bold text-slate-900 tracking-tight">About this Tool</h2>
            <a
              href={`https://github.com/${data.source.repo}#readme`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-blue-600 hover:underline flex items-center gap-1 font-medium"
            >
              <span>GitHub README</span>
              <span>↗</span>
            </a>
          </div>

          <article class="prose max-w-none text-slate-700 leading-relaxed overflow-hidden">
            <Content />
          </article>

          <!-- Upstream source attribution -->
          <div class="mt-8 pt-4 border-t border-slate-200 flex flex-wrap items-center justify-between text-xs text-slate-500 gap-3">
            <span>
              Source: <a href={`https://github.com/${data.source.repo}`} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline font-medium">{data.source.repo}</a>
              {data.source.license && ` · License: ${data.source.license}`}
            </span>
            <a
              href={`https://github.com/${data.source.repo}#readme`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-blue-600 hover:underline inline-flex items-center gap-1 font-medium"
            >
              <span>Read the full README on GitHub</span>
              <span>→</span>
            </a>
          </div>
        </section>

        <!-- Details & Selection Criteria -->
        <section id="details" class="py-8 border-t border-slate-200">
          <h2 class="text-xl font-bold text-slate-900 mb-4">Details &amp; Selection Criteria</h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
            <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs">
              <span class="text-xs text-slate-500 uppercase font-semibold tracking-wider block mb-1">Why it's listed</span>
              <p class="text-sm font-medium text-slate-800">
                {getWhyListedText(data.selection_reason, data.quality_percentile)}
              </p>
              <a href="/about/criteria" class="text-xs text-blue-600 hover:underline inline-block mt-2 font-medium">
                Learn how entries are selected →
              </a>
            </div>

            <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs">
              <span class="text-xs text-slate-500 uppercase font-semibold tracking-wider block mb-1">Execution &amp; Prerequisites</span>
              <p class="text-sm font-medium text-slate-800">
                Runtime: <strong class="uppercase">{data.tool.runtime}</strong> · Mode: <strong class="capitalize">{data.tool.execution_mode}</strong>
              </p>
              {data.prerequisites && data.prerequisites.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-2">
                  {data.prerequisites.map((p: string) => (
                    <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-700 text-[11px] font-mono border border-slate-200">
                      {p}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2 mb-4">
            <span class="text-xs text-slate-500 mr-1">Categories:</span>
            {data.categories.map((cat: string) => (
              <a
                href={`/catalog?category=${cat}`}
                class="px-3 py-1 rounded-md text-xs bg-white border border-slate-200 hover:border-slate-300 hover:bg-slate-50 text-slate-700 transition-colors shadow-xs"
              >
                {cat}
              </a>
            ))}
          </div>
        </section>

        <!-- Related Tools -->
        {relatedTools.length > 0 && (
          <section id="related" class="py-8 border-t border-slate-200">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-bold text-slate-900">Related Agent Tools</h2>
              <a href={`/catalog?category=${primaryCategory}`} class="text-xs text-blue-600 hover:underline font-medium">
                Explore {primaryCategory} →
              </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {relatedTools.map((rel) => (
                <a
                  href={`/tools/${rel.data.slug}`}
                  class="block p-4 rounded-xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all group"
                >
                  <div class="flex items-center justify-between mb-1.5">
                    <span class="font-bold text-slate-900 text-sm group-hover:text-blue-600 transition-colors truncate">
                      {rel.data.name}
                    </span>
                    <span class="text-xs font-mono text-slate-500 shrink-0">
                      ★ {formatStars(rel.data.signals.stars)}
                    </span>
                  </div>
                  <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                    {rel.data.summary || rel.data.tagline || 'Open AI agent tool.'}
                  </p>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      <!-- Right Column: Sticky Table of Contents & Quick Metadata -->
      <aside class="w-full lg:w-72 shrink-0">
        <div class="sticky top-24 space-y-6">
          {tocHeadings.length > 0 && (
            <div class="p-5 rounded-xl bg-white border border-slate-200 shadow-xs">
              <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-3">On this page</h3>
              <nav class="space-y-1.5 text-xs">
                <a href="#install" class="block text-slate-600 hover:text-blue-600 font-medium">Quickstart Install</a>
                {data.tool.has_mcp_support && data.tool.mcp_launch && (
                  <a href="#mcp-config" class="block text-slate-600 hover:text-blue-600 font-medium">MCP Config</a>
                )}
                <a href="#about" class="block text-slate-600 hover:text-blue-600 font-medium">About this Tool</a>
                {tocHeadings.slice(0, 8).map((h) => (
                  <a
                    href={`#${h.slug}`}
                    class={`block text-slate-500 hover:text-blue-600 truncate ${h.depth === 3 ? 'pl-2 text-[11px]' : ''}`}
                  >
                    {h.text}
                  </a>
                ))}
                <a href="#details" class="block text-slate-600 hover:text-blue-600 font-medium pt-1">Details &amp; Criteria</a>
                {relatedTools.length > 0 && (
                  <a href="#related" class="block text-slate-600 hover:text-blue-600 font-medium">Related Tools</a>
                )}
              </nav>
            </div>
          )}

          <div class="p-5 rounded-xl bg-white border border-slate-200 shadow-xs text-xs space-y-3">
            <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Tool Details</h3>
            <div class="flex justify-between py-1 border-b border-slate-100">
              <span class="text-slate-500">Subcategory</span>
              <span class="font-medium text-slate-800">{subcategoryLabel}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-slate-100">
              <span class="text-slate-500">Runtime</span>
              <span class="font-mono text-slate-800 uppercase">{data.tool.runtime}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-slate-100">
              <span class="text-slate-500">Execution</span>
              <span class="capitalize text-slate-800">{data.tool.execution_mode}</span>
            </div>
            <div class="flex justify-between py-1">
              <span class="text-slate-500">MCP Support</span>
              <span class="text-slate-800">{data.tool.has_mcp_support ? 'Yes' : 'No'}</span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <script>
    document.querySelectorAll('.copy-quickstart-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const cmd = btn.getAttribute('data-cmd') || '';
        if (cmd) {
          await navigator.clipboard.writeText(cmd);
          const original = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => {
            btn.textContent = original;
          }, 1500);
        }
      });
    });
  </script>
</BaseLayout>
