---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConfigTabs from '../../components/ConfigTabs.astro';
import DictionaryCard from '../../components/DictionaryCard.astro';
import { formatStars } from '../../lib/entries';

export async function getStaticPaths() {
  const mcpEntries = await getCollection('mcp');
  const byCategory = new Map<string, typeof mcpEntries>();

  for (const entry of mcpEntries) {
    for (const cat of entry.data.categories) {
      let list = byCategory.get(cat);
      if (!list) {
        list = [];
        byCategory.set(cat, list);
      }
      list.push(entry);
    }
  }
  for (const list of byCategory.values()) {
    list.sort((a, b) => (b.data.signals?.stars || 0) - (a.data.signals?.stars || 0));
  }

  return mcpEntries.map((entry) => {
    const primaryCategory = entry.data.categories[0] || 'other';
    const relatedTools = (byCategory.get(primaryCategory) || [])
      .filter((e) => e.data.slug !== entry.data.slug)
      .slice(0, 4);
    return {
      params: { slug: entry.data.slug },
      props: { entry, relatedTools },
    };
  });
}

const { entry, relatedTools = [] } = Astro.props;
const data = entry.data;
const { Content, headings } = await render(entry);

// Headings for table of contents
const tocHeadings = headings ? headings.filter((h) => h.depth >= 2 && h.depth <= 3) : [];
const primaryCategory = data.categories[0] || 'other';

// Format why listed in plain words (Task C5)
function getWhyListedText(reason: string, percentile: number): string {
  if (reason === 'official_vendor') {
    return 'Official vendor repository verified from primary provider';
  }
  if (reason === 'pinned') {
    return 'Curator highlighted entry';
  }
  const topPct = Math.max(1, 100 - (percentile || 0));
  return `Ranked in the top ${topPct}% by community adoption, code health, and recent maintenance`;
}
---

<BaseLayout
  title={`${data.name} — MCP Server for Claude Code, Codex, Antigravity`}
  description={data.summary || data.tagline || `Launch configuration and documentation for ${data.name} MCP server.`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6">
      <a href="/" class="hover:text-slate-900">Home</a>
      <span>/</span>
      <a href="/catalog?type=mcp_server" class="hover:text-slate-900">MCP Servers</a>
      <span>/</span>
      <span class="text-slate-800 font-medium">{data.name}</span>
    </nav>

    <!-- Unified Dictionary Entry Header -->
    <div class="mb-10">
      <DictionaryCard entry={entry} />
    </div>

    <!-- Language Note (Task C9, E3) -->
    {data.language && data.language !== 'en' && (
      <div class="mb-8 p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-xs flex items-center gap-3">
        <svg class="w-5 h-5 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
        </svg>
        <p>
          <strong>Notice:</strong> This repository's primary documentation is written in {data.language === 'zh' ? 'Chinese' : data.language}. If you are browsing in English, your browser's automatic translation may be helpful.
        </p>
      </div>
    )}

    <!-- Main Content Area: 3. About (README) + Sticky TOC on Wide Screens -->
    <div class="flex flex-col lg:flex-row gap-10">
      <!-- Left / Main Reading Column -->
      <div class="min-w-0 flex-1 max-w-4xl">
        <section id="about" class="mb-12">
          <div class="flex items-center justify-between pb-3 mb-6 border-b border-slate-200">
            <h2 class="text-xl font-bold text-slate-900 tracking-tight">About this MCP Server</h2>
            <a
              href={`https://github.com/${data.source.repo}#readme`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-blue-600 hover:underline flex items-center gap-1 font-medium"
            >
              <span>GitHub README</span>
              <span>↗</span>
            </a>
          </div>

          <article class="prose max-w-none text-slate-700 leading-relaxed overflow-hidden">
            <Content />
          </article>

          <!-- Upstream source attribution & license (Task C3, §6.1) -->
          <div class="mt-8 pt-4 border-t border-slate-200 flex flex-wrap items-center justify-between text-xs text-slate-500 gap-3">
            <span>
              Source: <a href={`https://github.com/${data.source.repo}`} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline font-medium">{data.source.repo}</a>
              {data.source.license && ` · License: ${data.source.license}`}
            </span>
            <a
              href={`https://github.com/${data.source.repo}#readme`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-blue-600 hover:underline inline-flex items-center gap-1 font-medium"
            >
              <span>Read the full README on GitHub</span>
              <span>→</span>
            </a>
          </div>
        </section>

        <!-- 4. Details section (Task C5) -->
        <section id="details" class="py-8 border-t border-slate-200">
          <h2 class="text-xl font-bold text-slate-900 mb-4">Details &amp; Selection Criteria</h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
            <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs">
              <span class="text-xs text-slate-500 uppercase font-semibold tracking-wider block mb-1">Why it's listed</span>
              <p class="text-sm font-medium text-slate-800">
                {getWhyListedText(data.selection_reason, data.quality_percentile)}
              </p>
              <a href="/about/criteria" class="text-xs text-blue-600 hover:underline inline-block mt-2 font-medium">
                Learn how entries are selected →
              </a>
            </div>

            <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs">
              <span class="text-xs text-slate-500 uppercase font-semibold tracking-wider block mb-1">Prerequisites &amp; Keys</span>
              <p class="text-sm font-medium text-slate-800">
                {data.needs_keys ? 'Requires API keys or environment credentials' : 'No API keys required'}
              </p>
              {data.prerequisites && data.prerequisites.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-2">
                  {data.prerequisites.map((p: string) => (
                    <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-700 text-[11px] font-mono border border-slate-200">
                      {p}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2 mb-4">
            <span class="text-xs text-slate-500 mr-1">Categories:</span>
            {data.categories.map((cat: string) => (
              <a
                href={`/category/${cat}`}
                class="px-3 py-1 rounded-md text-xs bg-white border border-slate-200 hover:border-slate-300 hover:bg-slate-50 text-slate-700 transition-colors shadow-xs"
              >
                {cat}
              </a>
            ))}
          </div>
        </section>

        <!-- 5. Related Tools (Task C6) -->
        {relatedTools.length > 0 && (
          <section id="related" class="py-8 border-t border-slate-200">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-bold text-slate-900">Related MCP Servers</h2>
              <a href={`/category/${primaryCategory}`} class="text-xs text-blue-600 hover:underline font-medium">
                Explore {primaryCategory} →
              </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {relatedTools.map((rel) => (
                <a
                  href={`/mcp/${rel.data.slug}`}
                  class="block p-4 rounded-xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all group"
                >
                  <div class="flex items-center justify-between mb-1.5">
                    <span class="font-bold text-slate-900 text-sm group-hover:text-blue-600 transition-colors truncate">
                      {rel.data.name}
                    </span>
                    <span class="text-xs font-mono text-slate-500 shrink-0">
                      ★ {formatStars(rel.data.signals.stars)}
                    </span>
                  </div>
                  <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                    {rel.data.summary || rel.data.tagline || 'Open MCP server.'}
                  </p>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- 6. Install section (LAST per §5.5, Task C1, C7) -->
        <section id="install" class="pt-10 pb-16 border-t border-slate-200">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
            <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">Install &amp; Setup</h2>
            <span class="text-xs text-slate-500 font-mono">1-Click Agent Integration</span>
          </div>
          <p class="text-xs text-slate-500 mb-6">
            Connect this server to Claude Code, OpenAI Codex, or Google Antigravity. Select your client below:
          </p>

          <!-- Prerequisites & keys help -->
          {data.launch.env_vars && data.launch.env_vars.length > 0 && (
            <div class="mb-6 rounded-xl border border-slate-200 bg-slate-50/70 p-4">
              <h3 class="text-xs font-semibold text-slate-800 uppercase tracking-wider mb-2">
                Required Environment Keys
              </h3>
              <div class="overflow-x-auto">
                <table class="w-full text-left text-xs font-mono">
                  <tbody class="divide-y divide-slate-200">
                    {data.launch.env_vars.map((v) => (
                      <tr>
                        <td class="py-2 pr-3 font-semibold text-blue-700">{v.name}</td>
                        <td class="py-2 pr-3">
                          <span class:list={[
                            'px-1.5 py-0.5 rounded text-[10px]',
                            v.required ? 'bg-amber-50 text-amber-800 border border-amber-200' : 'bg-slate-100 text-slate-600'
                          ]}>
                            {v.required ? 'Required' : 'Optional'}
                          </span>
                        </td>
                        <td class="py-2 text-slate-600 font-sans text-xs">
                          {v.description || 'API key or authentication token.'}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          <ConfigTabs
            type="mcp_server"
            name={data.name}
            launchSpec={data.launch}
            repo={data.source.repo}
            branch={data.readme_source?.branch || 'main'}
          />
        </section>
      </div>

      <!-- Right Column: Sticky Table of Contents on Wide Screens (Task C2) -->
      {tocHeadings.length > 0 && (
        <aside class="hidden lg:block w-64 shrink-0">
          <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto rounded-xl border border-slate-200 bg-white shadow-xs p-4 text-xs">
            <div class="font-semibold text-slate-900 uppercase tracking-wider text-[11px] mb-3">
              On this page
            </div>
            <nav class="space-y-1.5" aria-label="Table of contents">
              <a href="#about" class="block text-slate-700 hover:text-blue-600 transition-colors font-medium">
                About
              </a>
              {tocHeadings.map((h) => (
                <a
                  href={`#${h.slug}`}
                  class:list={[
                    'block text-slate-500 hover:text-blue-600 transition-colors line-clamp-1',
                    h.depth === 3 && 'pl-2 text-slate-400 hover:text-slate-600',
                  ]}
                >
                  {h.text}
                </a>
              ))}
              <a
                href="#details"
                class="block pt-2 text-slate-600 hover:text-blue-600 transition-colors font-medium border-t border-slate-200"
              >
                Details &amp; Selection
              </a>
              {relatedTools.length > 0 && (
                <a
                  href="#related"
                  class="block text-slate-600 hover:text-blue-600 transition-colors font-medium"
                >
                  Related Tools
                </a>
              )}
              <a
                href="#install"
                class="block pt-2 text-blue-600 hover:text-blue-700 transition-colors font-semibold border-t border-slate-200"
              >
                Jump to install ↓
              </a>
            </nav>
          </div>
        </aside>
      )}
    </div>
  </div>
</BaseLayout>
