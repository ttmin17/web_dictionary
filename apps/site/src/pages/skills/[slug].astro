---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConfigTabs from '../../components/ConfigTabs.astro';
import DictionaryCard from '../../components/DictionaryCard.astro';
import { formatStars } from '../../lib/entries';

export async function getStaticPaths() {
  const skillEntries = await getCollection('skills');

  // Pre-group by primary category (sorted by stars desc) and by repo (sorted by name asc) in O(N)
  const byCategory = new Map<string, typeof skillEntries>();
  const byRepo = new Map<string, typeof skillEntries>();

  for (const entry of skillEntries) {
    for (const cat of entry.data.categories) {
      let catList = byCategory.get(cat);
      if (!catList) {
        catList = [];
        byCategory.set(cat, catList);
      }
      catList.push(entry);
    }

    const repoKey = entry.data.source.repo;
    let repoList = byRepo.get(repoKey);
    if (!repoList) {
      repoList = [];
      byRepo.set(repoKey, repoList);
    }
    repoList.push(entry);
  }

  for (const list of byCategory.values()) {
    list.sort((a, b) => (b.data.signals?.stars || 0) - (a.data.signals?.stars || 0));
  }
  for (const list of byRepo.values()) {
    list.sort((a, b) => a.data.name.localeCompare(b.data.name));
  }

  return skillEntries.map((entry) => {
    const primaryCategory = entry.data.categories[0] || 'other';
    const catCandidates = byCategory.get(primaryCategory) || [];
    const relatedTools = catCandidates.filter((e) => e.data.slug !== entry.data.slug).slice(0, 4);

    const repoAll = byRepo.get(entry.data.source.repo) || [entry];
    const packTotalCount = repoAll.length;
    // Cap rendered pack drawer items to 24 (always keeping current entry visible) to avoid O(N^2) DOM bloat on 800-skill monorepos
    let packSkills = repoAll.slice(0, 24);
    if (packTotalCount > 24 && !packSkills.some((s) => s.data.slug === entry.data.slug)) {
      packSkills = [...repoAll.slice(0, 23), entry];
    }

    return {
      params: { slug: entry.data.slug },
      props: {
        entry,
        relatedTools,
        packSkills,
        packTotalCount,
      },
    };
  });
}

const { entry, relatedTools = [], packSkills = [], packTotalCount = 1 } = Astro.props;
const data = entry.data;
const { Content, headings } = await render(entry);

// Headings for table of contents
const tocHeadings = headings ? headings.filter((h) => h.depth >= 2 && h.depth <= 3) : [];
const primaryCategory = data.categories[0] || 'other';
const isPack = packTotalCount > 1;

// Format why listed in plain words (Task C5)
function getWhyListedText(reason: string, percentile: number): string {
  if (reason === 'official_vendor') {
    return 'Official vendor repository verified from primary provider';
  }
  if (reason === 'pinned') {
    return 'Curator highlighted entry';
  }
  const topPct = Math.max(1, 100 - (percentile || 0));
  return `Ranked in the top ${topPct}% by community adoption, code health, and recent maintenance`;
}

const cleanSubpath = data.skill.folder_path && data.skill.folder_path !== '.' ? data.skill.folder_path : '';
const upstreamSkillUrl = cleanSubpath
  ? `https://github.com/${data.source.repo}/tree/${data.readme_source?.branch || 'main'}/${cleanSubpath}`
  : `https://github.com/${data.source.repo}`;
---

<BaseLayout
  title={`${data.name} — Agent Skill for Claude Code, Codex, Antigravity`}
  description={data.summary || data.tagline || `Agent skill specification for ${data.name}.`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6">
      <a href="/" class="hover:text-slate-900">Home</a>
      <span>/</span>
      <a href="/catalog?type=agent_skill" class="hover:text-slate-900">Agent Skills</a>
      <span>/</span>
      <span class="text-slate-800 font-medium">{data.name}</span>
    </nav>

    <!-- Unified Dictionary Entry Header -->
    <div class="mb-10">
      <DictionaryCard entry={entry} />
    </div>

    <!-- 3. Language Note (Task C9, E3) -->
    {data.language && data.language !== 'en' && (
      <div class="mb-8 p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-xs flex items-center gap-3">
        <svg class="w-5 h-5 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
        </svg>
        <p>
          <strong>Notice:</strong> This skill documentation is written primarily in {data.language === 'zh' ? 'Chinese' : data.language}. If you are browsing in English, automatic browser translation may assist.
        </p>
      </div>
    )}

    <!-- Skill Pack Drawer Table (Step 5.3 FIX-4) -->
    {isPack && (
      <section class="mb-10 p-5 sm:p-6 rounded-2xl bg-amber-50/60 border border-amber-200 shadow-xs" aria-label="Repository Skill Pack">
        <div class="flex items-center justify-between pb-3 mb-4 border-b border-amber-200">
          <div class="flex items-center gap-2.5">
            <span class="text-xl">📦</span>
            <div>
              <h2 class="text-sm font-bold text-slate-900 tracking-tight">
                Repository Skill Pack: {packTotalCount} Skills in this Repository
              </h2>
              <p class="text-xs text-slate-600 mt-0.5">
                All skills packaged and maintained inside <code class="font-mono font-medium text-slate-800">{data.source.repo}</code>.
              </p>
            </div>
          </div>
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-amber-100 text-amber-800 border border-amber-300 font-mono">
            {packTotalCount} Skills
          </span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
          {packSkills.map((s) => {
            const isCurrent = s.data.slug === data.slug;
            return (
              <a
                href={`/skills/${s.data.slug}`}
                class:list={[
                  'p-3 rounded-xl border text-xs transition-all flex flex-col justify-between',
                  isCurrent
                    ? 'bg-amber-100/90 border-amber-300 shadow-xs font-semibold text-slate-900 ring-1 ring-amber-300'
                    : 'bg-white border-amber-200/80 hover:border-amber-300 hover:bg-white/90 text-slate-700'
                ]}
              >
                <div class="flex items-center justify-between gap-2 mb-1">
                  <span class="truncate font-mono">{s.data.name}</span>
                  {isCurrent && <span class="text-[10px] uppercase font-bold text-amber-800 bg-amber-200/80 px-1 rounded">Current</span>}
                </div>
                <p class="text-[11px] text-slate-500 line-clamp-1">{s.data.tagline || s.data.summary || s.data.skill.description}</p>
              </a>
            );
          })}
        </div>
        {packTotalCount > packSkills.length && (
          <p class="mt-3 text-xs text-amber-800 font-medium">
            Showing {packSkills.length} of {packTotalCount} skills in <code class="font-mono">{data.source.repo}</code>. Use the catalog search to browse all skills from this repository.
          </p>
        )}
      </section>
    )}

    <!-- Main Content Area: 3. SKILL.md Body + Sticky TOC on Wide Screens -->
    <div class="flex flex-col lg:flex-row gap-10">
      <!-- Left / Main Reading Column -->
      <div class="min-w-0 flex-1 max-w-4xl">
        <section id="about" class="mb-12">
          <div class="flex items-center justify-between pb-3 mb-6 border-b border-slate-200">
            <h2 class="text-xl font-bold text-slate-900 tracking-tight">Skill Instructions (SKILL.md)</h2>
            <a
              href={upstreamSkillUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-blue-600 hover:underline flex items-center gap-1 font-medium"
            >
              <span>GitHub File</span>
              <span>↗</span>
            </a>
          </div>

          <article class="prose max-w-none text-slate-700 leading-relaxed overflow-hidden">
            <Content />
          </article>

          <!-- Upstream source attribution & license (Task C3, §6.1) -->
          <div class="mt-8 pt-4 border-t border-slate-200 flex flex-wrap items-center justify-between text-xs text-slate-500 gap-3">
            <span>
              Source: <a href={`https://github.com/${data.source.repo}`} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline font-medium">{data.source.repo}</a>
              {data.source.license && ` · License: ${data.source.license}`}
            </span>
            <a
              href={upstreamSkillUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-blue-600 hover:underline inline-flex items-center gap-1 font-medium"
            >
              <span>View full SKILL.md on GitHub</span>
              <span>→</span>
            </a>
          </div>
        </section>

        <!-- 4. Details section (Task C5) -->
        <section id="details" class="py-8 border-t border-slate-200">
          <h2 class="text-xl font-bold text-slate-900 mb-4">Details &amp; Selection Criteria</h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
            <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs">
              <span class="text-xs text-slate-500 uppercase font-semibold tracking-wider block mb-1">Why it's listed</span>
              <p class="text-sm font-medium text-slate-800">
                {getWhyListedText(data.selection_reason, data.quality_percentile)}
              </p>
              <a href="/about/criteria" class="text-xs text-blue-600 hover:underline inline-block mt-2 font-medium">
                Learn how entries are selected →
              </a>
            </div>

            <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs">
              <span class="text-xs text-slate-500 uppercase font-semibold tracking-wider block mb-1">Skill Resources</span>
              {data.skill.extra_files && data.skill.extra_files.length > 0 ? (
                <div class="space-y-1 mt-1">
                  <span class="text-xs text-slate-500 block mb-1">Bundled extra files:</span>
                  <div class="flex flex-wrap gap-1.5">
                    {data.skill.extra_files.map((file: string) => (
                      <span class="px-2 py-0.5 rounded bg-slate-100 text-teal-800 text-[11px] font-mono border border-slate-200">
                        {file}
                      </span>
                    ))}
                  </div>
                </div>
              ) : (
                <p class="text-sm text-slate-600 mt-1">Standalone skill instructions file.</p>
              )}
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2 mb-4">
            <span class="text-xs text-slate-500 mr-1">Categories:</span>
            {data.categories.map((cat: string) => (
              <a
                href={`/category/${cat}`}
                class="px-3 py-1 rounded-md text-xs bg-white border border-slate-200 hover:border-slate-300 hover:bg-slate-50 text-slate-700 transition-colors shadow-xs"
              >
                {cat}
              </a>
            ))}
          </div>
        </section>

        <!-- 5. Related Skills (Task C6) -->
        {relatedTools.length > 0 && (
          <section id="related" class="py-8 border-t border-slate-200">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-bold text-slate-900">Related Agent Skills</h2>
              <a href={`/category/${primaryCategory}`} class="text-xs text-blue-600 hover:underline font-medium">
                Explore {primaryCategory} →
              </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {relatedTools.map((rel) => (
                <a
                  href={`/skills/${rel.data.slug}`}
                  class="block p-4 rounded-xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all group"
                >
                  <div class="flex items-center justify-between mb-1.5">
                    <span class="font-bold text-slate-900 text-sm group-hover:text-blue-600 transition-colors truncate">
                      {rel.data.name}
                    </span>
                    <span class="text-xs font-mono text-slate-500 shrink-0">
                      ★ {formatStars(rel.data.signals.stars)}
                    </span>
                  </div>
                  <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                    {rel.data.summary || rel.data.tagline || 'Agent skill.'}
                  </p>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- 6. Install section (LAST per §5.5, Task C1, C7) -->
        <section id="install" class="pt-10 pb-16 border-t border-slate-200">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
            <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">Install &amp; Setup</h2>
            <span class="text-xs text-slate-500 font-mono">Agent Skill Instructions</span>
          </div>
          <p class="text-xs text-slate-500 mb-6">
            Load this skill into Claude Code, OpenAI Codex, or Google Antigravity. Select your client below:
          </p>

          <ConfigTabs
            type="agent_skill"
            name={data.name}
            skillSpec={data.skill}
            repo={data.source.repo}
            branch={data.readme_source?.branch || 'main'}
            subpath={data.skill.folder_path}
          />
        </section>
      </div>

      <!-- Right Column: Sticky Table of Contents on Wide Screens (Task C2) -->
      {tocHeadings.length > 0 && (
        <aside class="hidden lg:block w-64 shrink-0">
          <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto rounded-xl border border-slate-200 bg-white shadow-xs p-4 text-xs">
            <div class="font-semibold text-slate-900 uppercase tracking-wider text-[11px] mb-3">
              On this page
            </div>
            <nav class="space-y-1.5" aria-label="Table of contents">
              <a href="#about" class="block text-slate-700 hover:text-blue-600 transition-colors font-medium">
                Instructions
              </a>
              {tocHeadings.map((h) => (
                <a
                  href={`#${h.slug}`}
                  class:list={[
                    'block text-slate-500 hover:text-blue-600 transition-colors line-clamp-1',
                    h.depth === 3 && 'pl-2 text-slate-400 hover:text-slate-600',
                  ]}
                >
                  {h.text}
                </a>
              ))}
              <a
                href="#details"
                class="block pt-2 text-slate-600 hover:text-blue-600 transition-colors font-medium border-t border-slate-200"
              >
                Details &amp; Selection
              </a>
              {relatedTools.length > 0 && (
                <a
                  href="#related"
                  class="block text-slate-600 hover:text-blue-600 transition-colors font-medium"
                >
                  Related Skills
                </a>
              )}
              <a
                href="#install"
                class="block pt-2 text-blue-600 hover:text-blue-700 transition-colors font-semibold border-t border-slate-200"
              >
                Jump to install ↓
              </a>
            </nav>
          </div>
        </aside>
      )}
    </div>
  </div>
</BaseLayout>
