---
import { getAllEntries } from '../lib/entries';
import EntryCard from './EntryCard.astro';

interface Props {
  initialType?: string;
  initialCategory?: string;
  initialClient?: string;
  initialSort?: string;
  initialOfficial?: boolean;
  pageTitle?: string;
  pageDescription?: string;
}

const {
  initialType = 'all',
  initialCategory = 'all',
  initialClient = 'all',
  initialSort = 'popular',
  initialOfficial = false,
  pageTitle,
  pageDescription,
} = Astro.props;

const allEntries = await getAllEntries();

const categoryList = [
  { id: 'all', name: 'All Categories' },
  { id: 'coding-agents', name: 'Coding & Dev' },
  { id: 'browser-web', name: 'Browser & Web' },
  { id: 'databases-memory', name: 'Databases & Memory' },
  { id: 'agent-frameworks', name: 'Frameworks' },
  { id: 'productivity-ops', name: 'Productivity' },
  { id: 'cloud-infra', name: 'Cloud & DevOps' },
  { id: 'media-creative', name: 'Media & Docs' },
  { id: 'security-auth', name: 'Security' },
  { id: 'domain-research', name: 'Research & Domain' },
  { id: 'other', name: 'Other Utilities' },
];

const clientList = [
  { id: 'all', name: 'All Clients' },
  { id: 'claude-code', name: 'Claude Code' },
  { id: 'codex', name: 'OpenAI Codex' },
  { id: 'antigravity', name: 'Google Antigravity' },
];

// Calculate monorepo Skill Packs mapping (Step 5.3 FIX-4)
const repoSkillCounts = new Map<string, number>();
const repoSkillNames = new Map<string, string[]>();
const repoPrimarySkillSlug = new Map<string, string>();

for (const e of allEntries) {
  if (e.data.type === 'agent_skill') {
    const repo = e.data.source.repo;
    const currentCount = repoSkillCounts.get(repo) || 0;
    repoSkillCounts.set(repo, currentCount + 1);

    const names = repoSkillNames.get(repo) || [];
    names.push(e.data.name);
    repoSkillNames.set(repo, names);

    const isExplicitPrimary = e.data.skill?.is_pack_primary === true;
    if (!repoPrimarySkillSlug.has(repo) || isExplicitPrimary) {
      repoPrimarySkillSlug.set(repo, e.data.slug);
    }
  }
}

// Serialize lightweight items for client-side instant filtering
const basePrefix = import.meta.env.BASE_URL.replace(/\/$/, '');

const clientItems = allEntries.map((e) => {
  const d = e.data;
  const [owner, repoShortName] = d.source.repo.split('/');
  const isSkill = d.type === 'agent_skill';
  const packCount = isSkill ? (repoSkillCounts.get(d.source.repo) || 1) : 1;
  const isPrimary = isSkill ? (repoPrimarySkillSlug.get(d.source.repo) === d.slug) : true;
  const packSkills = isSkill ? (repoSkillNames.get(d.source.repo) || []) : [];
  const clients = isSkill
    ? (d.skill?.clients || ['claude-code', 'codex', 'antigravity'])
    : (d.type === 'mcp_server' || d.tool?.has_mcp_support)
      ? ['claude-code', 'codex', 'antigravity']
      : [];

  return {
    slug: d.slug,
    type: d.type,
    name: d.name,
    repoName: repoShortName || d.name,
    owner,
    repo: d.source.repo,
    tagline: d.tagline || '',
    summary: d.summary || d.tagline || '',
    categories: d.categories || [],
    category: d.categories[0] || 'other',
    clients,
    status: d.status || 'active',
    stars: d.signals?.stars || 0,
    starsDelta7d: d.signals?.stars_delta_7d || 0,
    trendingScore: d.signals?.trending_score || 0,
    rankCurrent: d.signals?.rank_current || null,
    sparkline4w: d.signals?.sparkline_4w || [],
    lastCommit: d.signals?.last_commit || '',
    firstSeen: d.first_seen || '',
    license: d.source?.license || '',
    official: Boolean(d.source?.official_vendor),
    href: `${basePrefix}/${d.type === 'mcp_server' ? 'mcp' : d.type === 'agent_tool' ? 'tools' : 'skills'}/${d.slug}`,
    packCount,
    isPrimary,
    packSkills,
  };
});

// Pre-render the top 24 for SEO and immediate layout (collapsing skill packs by default)
const initialItems = allEntries
  .filter((e) => {
    if (initialType !== 'all' && e.data.type !== initialType) return false;
    if (initialCategory !== 'all' && !e.data.categories.includes(initialCategory)) return false;
    if (initialClient !== 'all') {
      const supportedClients = e.data.type === 'agent_skill'
        ? (e.data.skill?.clients || ['claude-code', 'codex', 'antigravity'])
        : (e.data.type === 'mcp_server' || e.data.tool?.has_mcp_support)
          ? ['claude-code', 'codex', 'antigravity']
          : [];
      if (!supportedClients.includes(initialClient as any)) return false;
    }
    if (initialOfficial && !e.data.source.official_vendor) return false;
    if (e.data.type === 'agent_skill') {
      const isPrimary = repoPrimarySkillSlug.get(e.data.source.repo) === e.data.slug;
      if (!isPrimary) return false;
    }
    return true;
  })
  .sort((a, b) => {
    if (initialSort === 'trending') {
      return (b.data.signals?.trending_score || 0) - (a.data.signals?.trending_score || 0);
    }
    return (b.data.signals?.stars || 0) - (a.data.signals?.stars || 0);
  })
  .slice(0, 24);
---

<div
  class="catalog-view max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8"
  data-initial-type={initialType}
  data-initial-category={initialCategory}
  data-initial-client={initialClient}
  data-initial-sort={initialSort}
  data-initial-official={initialOfficial ? 'true' : 'false'}
>
  {pageTitle && (
    <div class="mb-8 border-b border-slate-200 pb-6">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        {pageTitle}
      </h1>
      {pageDescription && (
        <p class="text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed">
          {pageDescription}
        </p>
      )}
    </div>
  )}

  <div class="flex flex-col lg:flex-row gap-8 items-start">
    <!-- Filter Sidebar (Drawer on mobile) -->
    <aside class="w-full lg:w-64 shrink-0 bg-white rounded-xl p-5 border border-slate-200 shadow-xs">
      <div class="flex items-center justify-between lg:hidden mb-3">
        <span class="text-xs font-bold text-slate-800 uppercase tracking-wider">Filters &amp; Refine</span>
        <button type="button" id="toggle-mobile-filters" class="text-xs text-blue-600 font-medium">
          Toggle
        </button>
      </div>

      <div id="filter-controls-body" class="space-y-6">
        <!-- Type Filter -->
        <div>
          <label class="block text-xs font-semibold text-slate-800 uppercase tracking-wider mb-2">
            Tool Type
          </label>
          <div class="space-y-1.5">
            <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer hover:text-slate-900">
              <input type="radio" name="filter-type" value="all" checked={initialType === 'all'} class="text-blue-600 focus:ring-0" />
              <span>All Types</span>
            </label>
            <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer hover:text-slate-900">
              <input type="radio" name="filter-type" value="mcp_server" checked={initialType === 'mcp_server'} class="text-blue-600 focus:ring-0" />
              <span>MCP Servers</span>
            </label>
            <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer hover:text-slate-900">
              <input type="radio" name="filter-type" value="agent_skill" checked={initialType === 'agent_skill'} class="text-blue-600 focus:ring-0" />
              <span>Agent Skills</span>
            </label>
            <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer hover:text-slate-900">
              <input type="radio" name="filter-type" value="agent_tool" checked={initialType === 'agent_tool'} class="text-blue-600 focus:ring-0" />
              <span>Agent Tools</span>
            </label>
          </div>
        </div>

        <!-- Category Filter -->
        <div>
          <label class="block text-xs font-semibold text-slate-800 uppercase tracking-wider mb-2">
            Category
          </label>
          <select
            id="filter-category"
            class="w-full rounded-lg bg-white border border-slate-200 text-xs text-slate-800 p-2 focus:border-blue-500 focus:outline-none"
          >
            {categoryList.map((c) => (
              <option value={c.id} selected={initialCategory === c.id}>{c.name}</option>
            ))}
          </select>
        </div>

        <!-- Client Filter -->
        <div>
          <label class="block text-xs font-semibold text-slate-800 uppercase tracking-wider mb-2">
            AI Client
          </label>
          <select
            id="filter-client"
            class="w-full rounded-lg bg-white border border-slate-200 text-xs text-slate-800 p-2 focus:border-blue-500 focus:outline-none"
          >
            {clientList.map((c) => (
              <option value={c.id} selected={initialClient === c.id}>{c.name}</option>
            ))}
          </select>
        </div>

        <!-- Official Only Checkbox -->
        <div>
          <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer hover:text-slate-900 pt-1">
            <input
              type="checkbox"
              id="filter-official"
              checked={initialOfficial}
              class="rounded border-slate-300 text-blue-600 focus:ring-0"
            />
            <span class="font-medium text-slate-800">Official Vendors only</span>
          </label>
        </div>

        <!-- Skill Packs Grouping Checkbox (Step 5.3 FIX-4) -->
        <div class="pt-2 border-t border-slate-100">
          <label class="block text-xs font-semibold text-slate-800 uppercase tracking-wider mb-2">
            Skill Packs
          </label>
          <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer hover:text-slate-900">
            <input
              type="checkbox"
              id="filter-collapse-packs"
              checked
              class="rounded border-slate-300 text-blue-600 focus:ring-0"
            />
            <span class="font-medium text-slate-800">Group skills by repo</span>
          </label>
          <p class="text-[11px] text-slate-500 mt-1 leading-normal">
            Collapses multi-skill repos into 1 representative card. Uncheck to browse all individual skills.
          </p>
        </div>

        <!-- License Filter -->
        <div>
          <label class="block text-xs font-semibold text-slate-800 uppercase tracking-wider mb-2">
            License
          </label>
          <select
            id="filter-license"
            class="w-full rounded-lg bg-white border border-slate-200 text-xs text-slate-800 p-2 focus:border-blue-500 focus:outline-none"
          >
            <option value="all">All Open Licenses</option>
            <option value="MIT">MIT</option>
            <option value="Apache-2.0">Apache 2.0</option>
            <option value="GPL">GPL / LGPL</option>
            <option value="BSD">BSD</option>
          </select>
        </div>

        <!-- Reset button -->
        <button
          type="button"
          id="btn-clear-filters"
          class="w-full py-2 px-3 rounded-lg border border-slate-200 hover:border-slate-300 bg-slate-50 text-xs text-slate-600 hover:text-slate-900 transition-colors cursor-pointer"
        >
          Reset all filters
        </button>
      </div>
    </aside>

    <!-- Results Main Column -->
    <div class="flex-1 w-full min-w-0">
      <!-- Search, Sort & View Controls Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4 pb-4 border-b border-slate-200">
        <!-- Live Quick Filter Text Search -->
        <div class="relative flex-1 max-w-md">
          <input
            type="text"
            id="filter-search-input"
            placeholder="Filter by keyword (name, description, owner)..."
            class="w-full pl-9 pr-4 py-2 rounded-lg bg-white border border-slate-200 text-xs text-slate-900 placeholder-slate-400 focus:border-blue-500 focus:outline-none transition-colors shadow-xs"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <div class="flex items-center gap-3 self-end sm:self-auto">
          <!-- Sort -->
          <div class="flex items-center gap-1.5 text-xs text-slate-600">
            <span class="hidden sm:inline">Sort:</span>
            <select
              id="filter-sort"
              class="rounded-lg bg-white border border-slate-200 text-xs text-slate-800 p-2 focus:border-blue-500 focus:outline-none shadow-xs"
            >
              <option value="trending" selected={initialSort === 'trending'}>🔥 Trending This Week</option>
              <option value="popular" selected={initialSort === 'popular'}>Most Popular (Stars)</option>
              <option value="updated" selected={initialSort === 'updated'}>Recently Updated</option>
              <option value="newest" selected={initialSort === 'newest'}>Newest Added</option>
              <option value="name" selected={initialSort === 'name'}>Name (A–Z)</option>
            </select>
          </div>

          <!-- Grid / List View Toggle (Task D3) -->
          <div class="flex items-center rounded-lg border border-slate-200 bg-white p-0.5 shadow-xs">
            <button
              type="button"
              id="view-grid-btn"
              title="Card Grid View"
              class="p-1.5 rounded text-xs text-slate-900 bg-slate-100 focus:outline-none cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
              </svg>
            </button>
            <button
              type="button"
              id="view-list-btn"
              title="Compact Table / List View"
              class="p-1.5 rounded text-xs text-slate-400 hover:text-slate-800 focus:outline-none cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Active Filters Chips & Result Count (Task D2) -->
      <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
        <div id="active-filter-chips" class="flex flex-wrap items-center gap-1.5 text-xs">
          <!-- Filled dynamically by JavaScript -->
        </div>
        <div id="result-count" class="text-xs font-mono text-slate-500">
          Showing {initialItems.length} of {allEntries.filter(e => e.data.type !== 'agent_skill' || repoPrimarySkillSlug.get(e.data.source.repo) === e.data.slug).length} repositories ({allEntries.length} total tools & skills)
        </div>
      </div>

      <!-- Cards Grid Container -->
      <div id="catalog-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        {initialItems.map((entry) => (
          <EntryCard
            entry={entry}
            packSkillsCount={repoSkillCounts.get(entry.data.source.repo)}
            packSkillNames={repoSkillNames.get(entry.data.source.repo)}
          />
        ))}
      </div>

      <!-- Compact List Container (hidden by default) -->
      <div id="catalog-list" class="hidden divide-y divide-slate-100 rounded-xl border border-slate-200 bg-white shadow-xs overflow-hidden">
        <!-- Filled dynamically by JavaScript -->
      </div>

      <!-- Empty State -->
      <div id="catalog-empty" class="hidden py-16 text-center rounded-xl border border-slate-200 bg-white">
        <p class="text-sm font-semibold text-slate-800">No tools match your current filter combination.</p>
        <p class="text-xs text-slate-500 mt-1">Try clearing some filters or searching with a different term.</p>
        <button type="button" id="btn-empty-reset" class="mt-4 px-4 py-2 rounded-lg bg-blue-600 text-xs font-semibold text-white hover:bg-blue-700 cursor-pointer">
          Reset all filters
        </button>
      </div>

      <!-- Pagination / Load More (Task D3) -->
      <div id="catalog-pagination" class="mt-10 text-center">
        <button
          type="button"
          id="btn-load-more"
          class="px-6 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 hover:border-slate-300 text-xs font-semibold text-slate-700 transition-colors shadow-xs inline-flex items-center gap-2 cursor-pointer"
        >
          <span>Load more tools</span>
          <span class="text-slate-400">(+24)</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Raw Catalog Items Data for Instant Client-Side Rendering -->
  <script id="catalog-items-json" type="application/json" set:html={JSON.stringify(clientItems)}></script>
</div>

<script>
  function setupCatalog() {
    const root = document.querySelector('.catalog-view');
    if (!root) return;

    const dataEl = document.getElementById('catalog-items-json');
    if (!dataEl) return;

    let items: any[] = [];
    try {
      items = JSON.parse(dataEl.textContent || '[]');
    } catch {
      return;
    }

    // Elements
    const gridContainer = document.getElementById('catalog-grid');
    const listContainer = document.getElementById('catalog-list');
    const emptyContainer = document.getElementById('catalog-empty');
    const chipsContainer = document.getElementById('active-filter-chips');
    const countEl = document.getElementById('result-count');
    const loadMoreBtn = document.getElementById('btn-load-more');
    const paginationContainer = document.getElementById('catalog-pagination');

    const typeRadios = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="filter-type"]'));
    const categorySelect = document.getElementById('filter-category') as HTMLSelectElement | null;
    const clientSelect = document.getElementById('filter-client') as HTMLSelectElement | null;
    const officialCheckbox = document.getElementById('filter-official') as HTMLInputElement | null;
    const collapsePacksCheckbox = document.getElementById('filter-collapse-packs') as HTMLInputElement | null;
    const licenseSelect = document.getElementById('filter-license') as HTMLSelectElement | null;
    const searchInput = document.getElementById('filter-search-input') as HTMLInputElement | null;
    const sortSelect = document.getElementById('filter-sort') as HTMLSelectElement | null;

    const gridBtn = document.getElementById('view-grid-btn');
    const listBtn = document.getElementById('view-list-btn');
    const clearBtn = document.getElementById('btn-clear-filters');
    const emptyResetBtn = document.getElementById('btn-empty-reset');

    // State
    const urlParams = new URLSearchParams(window.location.search);
    let state = {
      type: urlParams.get('type') || root.getAttribute('data-initial-type') || 'all',
      category: urlParams.get('category') || root.getAttribute('data-initial-category') || 'all',
      client: urlParams.get('client') || root.getAttribute('data-initial-client') || 'all',
      sort: urlParams.get('sort') || root.getAttribute('data-initial-sort') || 'popular',
      official: urlParams.get('official') === 'true' || root.getAttribute('data-initial-official') === 'true',
      collapsePacks: urlParams.get('collapsePacks') !== 'false',
      license: urlParams.get('license') || 'all',
      q: urlParams.get('q') || '',
      view: urlParams.get('view') || 'grid',
      pageSize: 24,
      limit: 24,
    };

    // Sync input values to state
    typeRadios.forEach((r) => {
      if (r.value === state.type) r.checked = true;
    });
    if (categorySelect) categorySelect.value = state.category;
    if (clientSelect) clientSelect.value = state.client;
    if (officialCheckbox) officialCheckbox.checked = state.official;
    if (collapsePacksCheckbox) collapsePacksCheckbox.checked = state.collapsePacks;
    if (licenseSelect) licenseSelect.value = state.license;
    if (searchInput) searchInput.value = state.q;
    if (sortSelect) sortSelect.value = state.sort;

    function syncUrl() {
      const p = new URLSearchParams();
      if (state.type !== 'all') p.set('type', state.type);
      if (state.category !== 'all') p.set('category', state.category);
      if (state.client !== 'all') p.set('client', state.client);
      if (state.sort !== 'popular') p.set('sort', state.sort);
      if (state.official) p.set('official', 'true');
      if (!state.collapsePacks) p.set('collapsePacks', 'false');
      if (state.license !== 'all') p.set('license', state.license);
      if (state.q) p.set('q', state.q);
      if (state.view !== 'grid') p.set('view', state.view);

      const newUrl = `${window.location.pathname}${p.toString() ? '?' + p.toString() : ''}`;
      window.history.replaceState({}, '', newUrl);
    }

    function formatNumber(num: number): string {
      if (num >= 1000) return (num / 1000).toFixed(1).replace(/\.0$/, '') + 'k';
      return String(num);
    }

    const categoryLabels: Record<string, string> = {
      'coding-agents': 'Coding & dev',
      'browser-web': 'Browser & web',
      'databases-memory': 'Databases & memory',
      'agent-frameworks': 'Frameworks',
      'productivity-ops': 'Productivity',
      'cloud-infra': 'Cloud & DevOps',
      'media-creative': 'Media & creative',
      'security-auth': 'Security',
      'domain-research': 'Research & domain',
      'other': 'Other utilities',
    };

    function renderSparklineSvg(points?: number[], width = 48, height = 14): string {
      if (!points || !Array.isArray(points) || points.length < 2) return '';
      const valid = points.filter((p) => typeof p === 'number' && Number.isFinite(p));
      const count = valid.length;
      if (count < 2) return '';

      const w = width;
      const h = height;
      const pad = 2;
      const usableW = Math.max(1, w - 2 * pad);
      const usableH = Math.max(1, h - 2 * pad);
      const min = Math.min(...valid);
      const max = Math.max(...valid);

      const isPositive = valid[count - 1] > valid[0];
      const isNegative = valid[count - 1] < valid[0];
      const strokeColor = isPositive ? 'text-emerald-500' : isNegative ? 'text-rose-500' : 'text-slate-400';

      let pointsStr = '';
      if (max === min) {
        const midY = (h / 2).toFixed(1);
        pointsStr = `${pad},${midY} ${(w - pad).toFixed(1)},${midY}`;
      } else {
        pointsStr = valid
          .map((p, i) => {
            const x = pad + (i / (count - 1)) * usableW;
            const y = h - pad - ((p - min) / (max - min)) * usableH;
            return `${x.toFixed(1)},${y.toFixed(1)}`;
          })
          .join(' ');
      }

      const dash = max === min ? 'stroke-dasharray="3 2" opacity="0.6"' : '';

      return `<div class="shrink-0 hidden sm:block" title="4-week trend">
        <svg class="inline-block overflow-visible ${strokeColor}" width="${w}" height="${h}" viewBox="0 0 ${w} ${h}">
          <polyline points="${pointsStr}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" ${dash} />
        </svg>
      </div>`;
    }

    function escapeHtml(str: unknown): string {
      return String(str ?? '').replace(/[&<>"']/g, (c) => {
        switch (c) {
          case '&': return '&amp;';
          case '<': return '&lt;';
          case '>': return '&gt;';
          case '"': return '&quot;';
          case "'": return '&#39;';
          default: return c;
        }
      });
    }

    function renderChips(_totalFiltered?: number) {
      if (!chipsContainer) return;
      chipsContainer.innerHTML = '';

      const chips: { label: string; reset: () => void }[] = [];

      if (state.type !== 'all') {
        const typeLabel =
          state.type === 'mcp_server'
            ? 'MCP Servers'
            : state.type === 'agent_tool'
            ? 'Agent Tools'
            : 'Agent Skills';
        chips.push({
          label: `Type: ${typeLabel}`,
          reset: () => {
            state.type = 'all';
            typeRadios.forEach((r) => { if (r.value === 'all') r.checked = true; });
          },
        });
      }

      if (state.category !== 'all') {
        chips.push({
          label: `Category: ${state.category}`,
          reset: () => {
            state.category = 'all';
            if (categorySelect) categorySelect.value = 'all';
          },
        });
      }

      if (state.client !== 'all') {
        chips.push({
          label: `Client: ${state.client}`,
          reset: () => {
            state.client = 'all';
            if (clientSelect) clientSelect.value = 'all';
          },
        });
      }

      if (state.official) {
        chips.push({
          label: 'Official only',
          reset: () => {
            state.official = false;
            if (officialCheckbox) officialCheckbox.checked = false;
          },
        });
      }

      if (state.license !== 'all') {
        chips.push({
          label: `License: ${state.license}`,
          reset: () => {
            state.license = 'all';
            if (licenseSelect) licenseSelect.value = 'all';
          },
        });
      }

      if (state.q) {
        chips.push({
          label: `Search: "${state.q}"`,
          reset: () => {
            state.q = '';
            if (searchInput) searchInput.value = '';
          },
        });
      }

      if (!state.collapsePacks) {
        chips.push({
          label: 'Skill Packs: Expanded',
          reset: () => {
            state.collapsePacks = true;
            if (collapsePacksCheckbox) collapsePacksCheckbox.checked = true;
          },
        });
      }

      chips.forEach((chip) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-blue-50 border border-blue-200 text-blue-700 hover:bg-blue-100 text-xs font-medium transition-colors cursor-pointer';
        btn.innerHTML = `<span>${escapeHtml(chip.label)}</span><span class="text-blue-500 font-bold">&times;</span>`;
        btn.addEventListener('click', () => {
          chip.reset();
          state.limit = state.pageSize;
          syncUrl();
          applyFilterAndRender();
        });
        chipsContainer.appendChild(btn);
      });

      if (chips.length > 1) {
        const clearAll = document.createElement('button');
        clearAll.type = 'button';
        clearAll.className = 'text-xs text-slate-500 hover:text-slate-800 underline ml-2 cursor-pointer';
        clearAll.textContent = 'Clear all';
        clearAll.addEventListener('click', () => {
          resetAllFilters();
        });
        chipsContainer.appendChild(clearAll);
      }
    }

    function resetAllFilters() {
      state.type = 'all';
      state.category = 'all';
      state.client = 'all';
      state.official = false;
      state.collapsePacks = true;
      state.license = 'all';
      state.q = '';
      state.limit = state.pageSize;

      typeRadios.forEach((r) => { if (r.value === 'all') r.checked = true; });
      if (categorySelect) categorySelect.value = 'all';
      if (clientSelect) clientSelect.value = 'all';
      if (officialCheckbox) officialCheckbox.checked = false;
      if (collapsePacksCheckbox) collapsePacksCheckbox.checked = true;
      if (licenseSelect) licenseSelect.value = 'all';
      if (searchInput) searchInput.value = '';

      syncUrl();
      applyFilterAndRender();
    }

    function applyFilterAndRender() {
      // 1. Filter
      const qLower = state.q.trim().toLowerCase();
      let filtered = items.filter((item: any) => {
        if (state.type !== 'all' && item.type !== state.type) return false;
        if (state.category !== 'all' && !item.categories.includes(state.category)) return false;
        if (state.client !== 'all' && !(item.clients || []).includes(state.client)) return false;
        if (state.official && !item.official) return false;
        if (state.collapsePacks && !qLower && item.type === 'agent_skill' && !item.isPrimary) return false;
        if (state.license !== 'all') {
          if (!item.license || !item.license.toLowerCase().includes(state.license.toLowerCase())) return false;
        }
        if (qLower) {
          const match =
            item.name.toLowerCase().includes(qLower) ||
            item.owner.toLowerCase().includes(qLower) ||
            (item.repo && item.repo.toLowerCase().includes(qLower)) ||
            (item.repoName && item.repoName.toLowerCase().includes(qLower)) ||
            item.summary.toLowerCase().includes(qLower) ||
            item.tagline.toLowerCase().includes(qLower);
          if (!match) return false;
        }
        return true;
      });

      // 2. Sort
      if (state.sort === 'trending') {
        filtered.sort((a: any, b: any) => (b.trendingScore || 0) - (a.trendingScore || 0));
      } else if (state.sort === 'popular') {
        filtered.sort((a: any, b: any) => (b.stars || 0) - (a.stars || 0));
      } else if (state.sort === 'updated') {
        filtered.sort((a: any, b: any) => (new Date(b.lastCommit).getTime() || 0) - (new Date(a.lastCommit).getTime() || 0));
      } else if (state.sort === 'newest') {
        filtered.sort((a: any, b: any) => (new Date(b.firstSeen).getTime() || 0) - (new Date(a.firstSeen).getTime() || 0));
      } else if (state.sort === 'name') {
        filtered.sort((a: any, b: any) => a.name.localeCompare(b.name));
      }

      // Update counters & chips
      const total = filtered.length;
      if (countEl) {
        if (state.collapsePacks && !qLower && (state.type === 'all' || state.type === 'agent_skill')) {
          const totalAll = items.length;
          countEl.textContent = `Showing ${Math.min(state.limit, total)} of ${total} repositories (${totalAll} total tools & skills)`;
        } else {
          countEl.textContent = `Showing ${Math.min(state.limit, total)} of ${total} tools & skills`;
        }
      }
      renderChips(total);

      // Handle empty state
      if (total === 0) {
        if (gridContainer) gridContainer.classList.add('hidden');
        if (listContainer) listContainer.classList.add('hidden');
        if (paginationContainer) paginationContainer.classList.add('hidden');
        if (emptyContainer) emptyContainer.classList.remove('hidden');
        return;
      }

      if (emptyContainer) emptyContainer.classList.add('hidden');

      // Paginate
      const visible = filtered.slice(0, state.limit);

      // Render Grid or List
      if (state.view === 'list') {
        if (gridContainer) gridContainer.classList.add('hidden');
        if (listContainer) {
          listContainer.classList.remove('hidden');
          listContainer.innerHTML = visible.map((item: any) => {
            const hasDelta = item.starsDelta7d && item.starsDelta7d > 0;
            const isPack = item.type === 'agent_skill' && item.packCount > 1;
            const displayName = escapeHtml((isPack && !qLower && item.repoName) ? item.repoName : item.name);
            const catLabel = escapeHtml(categoryLabels[item.category] || item.category);
            const safeOwner = escapeHtml(item.owner);
            const safeDesc = escapeHtml(item.summary || item.tagline);
            const safeHref = escapeHtml(item.href);
            return `
            <a href="${safeHref}" class="flex items-center justify-between p-3.5 hover:bg-slate-50 transition-colors group">
              <div class="flex items-center gap-3 min-w-0">
                <img src="https://github.com/${encodeURIComponent(item.owner)}.png?size=40" alt="${safeOwner}" class="w-8 h-8 rounded-lg bg-slate-50 border border-slate-200 object-cover shrink-0" loading="lazy" />
                <div class="min-w-0">
                  <div class="flex items-center gap-2">
                    <span class="font-semibold text-sm text-slate-900 group-hover:text-blue-600 truncate">${displayName}</span>
                    <span class="text-[10px] px-1.5 py-0.5 rounded font-mono ${
                      item.type === 'mcp_server'
                        ? 'bg-blue-50 text-blue-700 border border-blue-200'
                        : item.type === 'agent_tool'
                        ? 'bg-purple-50 text-purple-700 border border-purple-200'
                        : 'bg-teal-50 text-teal-700 border border-teal-200'
                    }">
                      ${item.type === 'mcp_server' ? 'MCP' : item.type === 'agent_tool' ? 'Tool' : 'Skill'}
                    </span>
                    ${isPack ? `<span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-50 text-amber-800 border border-amber-200 font-medium">📦 Pack (${Number(item.packCount) || 1})</span>` : ''}
                    ${item.official ? '<span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200 font-medium">Official</span>' : ''}
                  </div>
                  <p class="text-xs text-slate-500 truncate mt-0.5">${safeDesc}</p>
                </div>
              </div>
              <div class="flex items-center gap-4 text-xs text-slate-500 font-mono shrink-0 pl-3">
                <span class="hidden sm:inline text-slate-500">${catLabel}</span>
                <span class="text-slate-700">★ ${formatNumber(item.stars)}</span>
                ${hasDelta ? `<span class="text-orange-700 font-medium">+${formatNumber(item.starsDelta7d)}/wk</span>` : ''}
                ${renderSparklineSvg(item.sparkline4w, 40, 12)}
                <span class="text-blue-600 font-medium group-hover:translate-x-0.5 transition-transform">&rarr;</span>
              </div>
            </a>
          `;
          }).join('');
        }
      } else {
        if (listContainer) listContainer.classList.add('hidden');
        if (gridContainer) {
          gridContainer.classList.remove('hidden');
          gridContainer.innerHTML = visible.map((item: any) => {
            const isMcp = item.type === 'mcp_server';
            const isTool = item.type === 'agent_tool';
            const badgeClass = isMcp
              ? 'bg-blue-50 text-blue-700 border border-blue-200'
              : isTool
              ? 'bg-purple-50 text-purple-700 border border-purple-200'
              : 'bg-teal-50 text-teal-700 border border-teal-200';
            const badgeText = isMcp
              ? 'MCP server'
              : isTool
              ? 'Agent tool'
              : 'Agent skill';
            const isPack = item.type === 'agent_skill' && item.packCount > 1;
            const displayName = escapeHtml((isPack && !qLower && item.repoName) ? item.repoName : item.name);
            const escapedPackSkills = Array.isArray(item.packSkills) ? item.packSkills.map((s: string) => escapeHtml(s)) : [];
            const packSub = (isPack && escapedPackSkills.length > 0)
              ? `<p class="text-[11px] text-amber-800 font-normal truncate mt-0.5" title="${escapedPackSkills.join(', ')}">Includes: ${escapedPackSkills.slice(0, 3).join(', ')}${escapedPackSkills.length > 3 ? ` +${escapedPackSkills.length - 3} more` : ''}</p>`
              : '';
            const hasDelta = item.starsDelta7d && item.starsDelta7d > 0;
            const catLabel = escapeHtml(categoryLabels[item.category] || item.category);
            const safeOwner = escapeHtml(item.owner);
            const safeDesc = escapeHtml(item.summary || item.tagline);
            const safeHref = escapeHtml(item.href);
            return `
              <a href="${safeHref}" class="group flex flex-col justify-between p-5 rounded-xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all duration-150 text-left">
                <div>
                  <div class="flex items-start justify-between gap-3 mb-3">
                    <div class="flex items-start gap-3 min-w-0">
                      <img src="https://github.com/${encodeURIComponent(item.owner)}.png?size=64" alt="${safeOwner}" class="w-10 h-10 rounded-lg border border-slate-200 bg-slate-50 object-cover shrink-0" loading="lazy" />
                      <div class="min-w-0">
                        <h3 class="text-base font-semibold text-slate-900 group-hover:text-blue-600 transition-colors truncate">${displayName}</h3>
                        <p class="text-xs text-slate-500 font-mono truncate">${safeOwner}</p>
                        ${packSub}
                      </div>
                    </div>
                    <div class="flex flex-col items-end gap-1 shrink-0">
                      <span class="px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider rounded shrink-0 ${badgeClass}">
                        ${badgeText}
                      </span>
                      ${isPack ? `<span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-amber-50 text-amber-800 border border-amber-200 inline-flex items-center gap-1"><span>📦</span><span>Pack (${Number(item.packCount) || 1})</span></span>` : ''}
                    </div>
                  </div>
                  <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed mb-4">${safeDesc}</p>
                </div>
                <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500 font-sans gap-2">
                  <div class="flex items-center gap-1.5 truncate">
                    <span class="text-slate-700 font-medium truncate">${catLabel}</span>
                    <span class="text-slate-300">·</span>
                    <span class="text-slate-700 font-mono font-medium">★ ${formatNumber(item.stars)}</span>
                    ${hasDelta ? `<span class="text-slate-300">·</span><span class="inline-flex items-center gap-0.5 px-1.5 py-0.2 rounded font-mono font-medium text-[11px] bg-orange-50 text-orange-700 border border-orange-200"><span>+${formatNumber(item.starsDelta7d)}</span><span class="text-[9px]">/wk</span></span>` : ''}
                    <span class="text-slate-300">·</span>
                    <span class="inline-flex items-center gap-1 text-slate-600">
                      <span class="w-1.5 h-1.5 rounded-full inline-block bg-emerald-500"></span>
                      <span>Active</span>
                    </span>
                    ${item.official ? '<span class="text-slate-300">·</span><span class="text-blue-700 bg-blue-50 border border-blue-200 font-medium px-1.5 py-0.2 rounded text-[10px]">Official</span>' : ''}
                  </div>
                  ${renderSparklineSvg(item.sparkline4w)}
                </div>
              </a>
            `;
          }).join('');
        }
      }

      // Load more button visibility
      if (paginationContainer) {
        if (state.limit >= total) {
          paginationContainer.classList.add('hidden');
        } else {
          paginationContainer.classList.remove('hidden');
        }
      }
    }

    // Attach listeners
    typeRadios.forEach((r) => {
      r.addEventListener('change', () => {
        state.type = r.value;
        state.limit = state.pageSize;
        syncUrl();
        applyFilterAndRender();
      });
    });

    if (collapsePacksCheckbox) {
      collapsePacksCheckbox.addEventListener('change', () => {
        state.collapsePacks = collapsePacksCheckbox.checked;
        state.limit = state.pageSize;
        syncUrl();
        applyFilterAndRender();
      });
    }

    if (categorySelect) {
      categorySelect.addEventListener('change', () => {
        state.category = categorySelect.value;
        state.limit = state.pageSize;
        syncUrl();
        applyFilterAndRender();
      });
    }

    if (clientSelect) {
      clientSelect.addEventListener('change', () => {
        state.client = clientSelect.value;
        state.limit = state.pageSize;
        syncUrl();
        applyFilterAndRender();
      });
    }

    if (officialCheckbox) {
      officialCheckbox.addEventListener('change', () => {
        state.official = officialCheckbox.checked;
        state.limit = state.pageSize;
        syncUrl();
        applyFilterAndRender();
      });
    }

    if (licenseSelect) {
      licenseSelect.addEventListener('change', () => {
        state.license = licenseSelect.value;
        state.limit = state.pageSize;
        syncUrl();
        applyFilterAndRender();
      });
    }

    if (sortSelect) {
      sortSelect.addEventListener('change', () => {
        state.sort = sortSelect.value;
        syncUrl();
        applyFilterAndRender();
      });
    }

    let searchDebounce: any;
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        clearTimeout(searchDebounce);
        searchDebounce = setTimeout(() => {
          state.q = searchInput.value;
          state.limit = state.pageSize;
          syncUrl();
          applyFilterAndRender();
        }, 150);
      });
    }

    if (gridBtn && listBtn) {
      gridBtn.addEventListener('click', () => {
        state.view = 'grid';
        gridBtn.classList.add('bg-slate-100', 'text-slate-900');
        gridBtn.classList.remove('text-slate-400');
        listBtn.classList.remove('bg-slate-100', 'text-slate-900');
        listBtn.classList.add('text-slate-400');
        syncUrl();
        applyFilterAndRender();
      });

      listBtn.addEventListener('click', () => {
        state.view = 'list';
        listBtn.classList.add('bg-slate-100', 'text-slate-900');
        listBtn.classList.remove('text-slate-400');
        gridBtn.classList.remove('bg-slate-100', 'text-slate-900');
        gridBtn.classList.add('text-slate-400');
        syncUrl();
        applyFilterAndRender();
      });
    }

    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        state.limit += state.pageSize;
        applyFilterAndRender();
      });
    }

    if (clearBtn) clearBtn.addEventListener('click', resetAllFilters);
    if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAllFilters);

    // Initial render
    applyFilterAndRender();
  }

  setupCatalog();
  document.addEventListener('astro:page-load', setupCatalog);
</script>
